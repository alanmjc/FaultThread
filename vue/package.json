{
  "name": "@event-observability/vue",
  "version": "0.2.1",
  "description": "Vue error monitoring with configurable data capture and optional HTTP adapters.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js"},
    "./policy": {"types": "./dist/policy.d.ts", "import": "./dist/policy.js"},
    "./fetch": {"types": "./dist/fetch.d.ts", "import": "./dist/fetch.js"},
    "./axios": {"types": "./dist/axios.d.ts", "import": "./dist/axios.js"},
    "./vueuse": {"types": "./dist/vueuse.d.ts", "import": "./dist/vueuse.js"},
    "./rollup": {"types": "./dist/rollup.d.ts", "import": "./dist/rollup.js"},
    "./vite": {"types": "./dist/vite.d.ts", "import": "./dist/vite.js"}
  },
  "engines": {"node": ">=18"},
  "peerDependencies": {
    "@sentry/vue": ">=10.75.3 <11",
    "vue": "^3.5.42",
    "vue-router": "^4.3.0 || ^5.5.1",
    "axios": "^1.20.0",
    "@vueuse/core": ">=10.9.0 <16",
    "rollup": "^4.68.5",
    "vite": "^6.4.6 || ^7.3.8 || ^8.3.8",
    "@sentry/cli": "^2.58.6"
  },
  "peerDependenciesMeta": {
    "vue-router": {"optional": true},
    "axios": {"optional": true},
    "@vueuse/core": {"optional": true},
    "rollup": {"optional": true},
    "vite": {"optional": true},
    "@sentry/cli": {"optional": true}
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@sentry/vue": "10.75.3",
    "vue": "^3.5.42",
    "vue-router": "4.3.3",
    "axios": "^1.20.0",
    "@vueuse/core": "10.9.0",
    "rollup": "^4.68.5",
    "@sentry/cli": "2.58.6",
    "typescript": "^5.6.0",
    "vite": "6.4.6"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run typecheck && node --test",
    "typecheck": "npm run build && tsc -p tests/tsconfig.json"
  }
}
