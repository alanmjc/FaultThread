{
    "name": "faultthread/laravel",
    "description": "FaultThread error monitoring for Laravel with configurable data capture and HTTP request correlation.",
    "type": "library",
    "keywords": ["laravel", "observability", "sentry", "error-monitoring"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "laravel/framework": "^12.71 || ^13.40",
        "psr/log": "^3.0",
        "sentry/sentry": "^4.31",
        "sentry/sentry-laravel": "^4.28",
        "symfony/http-foundation": "^7.0 || ^8.0"
    },
    "conflict": {
        "event-observability/laravel": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "FaultThread\\Laravel\\": "src/"
        },
        "files": ["src/legacy-aliases.php"]
    },
    "extra": {
        "laravel": {
            "providers": ["FaultThread\\Laravel\\ObservabilityServiceProvider"]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "archive": {
        "exclude": ["/.env*", "/.phpunit.cache", "/phpunit.xml", "/vendor"]
    }
}
